# Sentryl Environment Configuration Template
APP_NAME="Sentryl API"
APP_VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (JSON array format)
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","https://mail.google.com","https://*.vercel.app","https://sentryl.ai","chrome-extension://*","edge-extension://*"]

# Official Microsoft Edge Add-ons Store URL
EDGE_EXTENSION_STORE_URL="https://microsoftedge.microsoft.com/addons/detail/ORDCKC10MVMZ"

# Input Protection Limits
MAX_BODY_LENGTH=100000
MAX_HEADERS_LENGTH=50000
MAX_URLS_COUNT=50
